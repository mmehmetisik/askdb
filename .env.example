# ========== Veritabani ==========
# Veritabani tipi: postgresql, mysql, mssql
DB_TYPE=postgresql

# PostgreSQL baglanti URL'si
POSTGRES_URL=postgresql://user:password@localhost:5432/your_database

# MySQL baglanti URL'si (DB_TYPE=mysql ise)
# DATABASE_URL=mysql://user:password@localhost:3306/your_database

# MSSQL baglanti URL'si (DB_TYPE=mssql ise)
# DATABASE_URL=mssql://user:password@localhost:1433/your_database

# Erisim izni verilen tablolar (virgul ile ayirin)
# Direct mod: customers,orders,order_items
# Trino mod: catalog.schema.table formati: hive.public.customers,hive.public.orders
ALLOWED_TABLES=customers,orders,order_items

# ========== DB Modu ==========
# "direct" = tek DB'ye dogrudan baglan (varsayilan)
# "trino" = Trino uzerinden cross-DB federation
DB_MODE=direct

# ========== Trino (DB_MODE=trino ise) ==========
# Trino baglanti URL'si
# TRINO_URL=trino://trino@localhost:8080/hive/default

# Varsayilan catalog ve schema (opsiyonel, URL'den parse edilir)
# TRINO_CATALOG=hive
# TRINO_SCHEMA=default

# Auth DB: Trino read-only oldugu icin app_users icin ayri yazilabilir DB
# AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
# AUTH_DB_TYPE=postgresql

# ========== LLM Ayarlari ==========
# LLM provider sirasi (virgul ile ayirin, fallback zinciri olusturur)
LLM_PROVIDER=groq

# Groq API Keys (https://console.groq.com)
# Birden fazla key tanimlayarak fallback zinciri olusturabilirsiniz
GROQ_API_KEY=your-groq-api-key-here
# GROQ_API_KEY_2=your-second-groq-key
# GROQ_API_KEY_3=your-third-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (opsiyonel, fallback icin)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key (opsiyonel, fallback icin)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ========== Guvenlik ==========
# JWT Secret Key — ZORUNLU! Production'da guclu ve benzersiz bir key kullanin
# Uretmek icin: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=your-strong-secret-key-here

# Varsayilan Admin Sifresi (Ilk calistirmada olusturulur)
DEFAULT_ADMIN_PASSWORD=Admin123!

# Cookie HTTPS zorunlulugu (localhost icin false, production icin true)
SECURE_COOKIE=true

# CSRF korumasi (SameSite=strict zaten aktif; ekstra koruma icin true yapin)
# CSRF_ENABLED=false

# ========== Uygulama ==========
# CORS izinli originler (virgul ile ayirin)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Sorgu sonucu maksimum satir sayisi (varsayilan: 5000)
MAX_QUERY_ROWS=5000

# ========== Redis (opsiyonel) ==========
# Redis URL (varsa cache ve rate limiter Redis kullanir, yoksa in-memory)
# REDIS_URL=redis://localhost:6379/0

# ========== Cache ==========
# Cache suresi (saniye, varsayilan: 300 = 5 dakika)
CACHE_TTL_SECONDS=300
# Maksimum cache boyutu (sadece in-memory modda gecerli)
MAX_CACHE_SIZE=100

# ========== Rate Limiting ==========
# Kullanici basi sorgu limiti (dakika basina)
RATE_LIMIT_USER=20
# Admin sorgu limiti
RATE_LIMIT_ADMIN=60
# Pencere suresi (saniye)
RATE_LIMIT_WINDOW=60

# ========== Railway API (Trino Servis Kontrolu) ==========
# Admin panelden Trino servisini Railway'de durdur/baslat (maliyet kontrolu)
# Token: Railway Dashboard → Account Settings → Tokens
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_TRINO_SERVICE_ID=

# ========== Logging ==========
# Log formati: "text" (varsayilan) veya "json" (structured)
# LOG_FORMAT=text
# Log seviyesi: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# Dosyaya log yazmak icin (bos = sadece konsol)
# LOG_FILE=logs/app.log
